# Template rendered by scripts/deploy.sh (scripts/deploy/service-linux.mjs).
[Unit]
Description=Agents-Chat (Next.js multi-agent chat UI)
Documentation=https://github.com/huanyingtianhe/agents-chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__/current
Environment=PORT=__PORT__
Environment=HOSTNAME=0.0.0.0

# Project env (KEY=VALUE per line). Leading '-' = file is optional.
EnvironmentFile=-__ROOT__/shared/.env.local
# Optional machine-level overrides (takes precedence over .env.local)
EnvironmentFile=-/etc/agents-chat.env

Environment=NODE_ENV=production
# Runs server.js with the Node.js binary the release was built with.
ExecStart=/bin/sh __ROOT__/current/scripts/run-release.sh

Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agents-chat

# Light sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
