# NextAuth
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=https://localhost:3010

# Azure AD (Microsoft Entra ID) — optional, leave CLIENT_ID empty to disable
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# GitHub OAuth — optional, leave CLIENT_ID empty to disable.
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: ${NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required when GitHub OAuth is enabled. Comma-separated GitHub account emails allowed to sign in.
# If empty, ADMIN_EMAILS is used as the fallback allowlist.
GITHUB_ALLOWED_EMAILS=

# Dev Tunnel used by start.ps1 when not using -Cloudflare
DEV_TUNNEL_NAME=
DEV_TUNNEL_URL=

# Admin credentials (used for local username/password login)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated emails treated as admin (for Azure AD users)
ADMIN_EMAILS=

# Optional voice input (Linux x86_64; Windows x64 development runtime).
# Disabled by default. Use absolute paths to the verified Actions runtime artifact.
# Changes require restarting the application; no frontend rebuild is needed.
VOICE_ENABLED=0
# Without VOICE_MODEL, existing Whisper paths keep the legacy low-memory policy.
VOICE_WHISPER_PATH=
VOICE_MODEL_PATH=
# Explicit model selection defaults to standard native subprocess execution.
# No application CPU/RAM hard quota; external OS/container limits still apply.
# VOICE_MODEL=sensevoice-small-q8
# VOICE_BINARY_PATH=/absolute/path/to/llama-funasr-sensevoice
# VOICE_MODEL_PATH=/absolute/path/to/sensevoice-small-q8.gguf
# VOICE_THREADS=2
# VOICE_RESOURCE_POLICY=standard
# Windows development integration additionally requires the matching native helper:
# VOICE_LAUNCHER_PATH=C:/absolute/path/to/voice-job.exe
# Windows requires an explicit model and standard policy. Native model packages,
# Windows installer integration and actual Windows 11 qualification are pending.
# Other model: whisper-base-q5_1 (default 1 thread; Sense defaults to 2).
# Supported thread values: 1, 2, 4. Legacy-low-memory requires one-thread Whisper.

# Azure Relay — required for relay agents and node probing/discovery
# Set RELAY_SEND_CONNECTION_STRING to enable relay agent connections.
# Set RELAY_SUBSCRIPTION_ID + RELAY_RESOURCE_GROUP to let generated setup ZIPs
# create/update/delete relay hybrid connections. Add RELAY_NAMESPACE to enable
# auto-discovery of relay nodes via the Azure ARM API.
RELAY_SEND_CONNECTION_STRING=
# Key Vault defaults embedded into newly downloaded node setup ZIPs.
# Leave blank if you pass RELAY_CONNECTION_STRING directly to setup-node.ps1.
# After changing setup ZIP values, restart or redeploy the app and download a new copilot-node-setup.zip.
RELAY_KEY_VAULT_NAME=
RELAY_KEY_VAULT_SECRET_NAME=
RELAY_SUBSCRIPTION_ID=
RELAY_RESOURCE_GROUP=
RELAY_NAMESPACE=

# Logging (pino + pino-roll)
# LOG_LEVEL: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Directory (relative to cwd) where rotated log files are written
LOG_DIR=logs
# Base log file name; rotated files get a date/index suffix
LOG_FILE=app.log
# Rotation frequency: daily | hourly | <milliseconds>
LOG_ROTATE_FREQUENCY=daily
# Max size per file before rotation (e.g. 10m, 500k, 1g)
LOG_ROTATE_SIZE=10m
# Number of rotated files to retain
LOG_RETENTION=7
